---
import Nav from '../sections/Nav.astro';
import Footer from '../sections/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Page not found — Grablytic, the private yt-dlp media downloader for Android and desktop." />
  <title>Page not found — Grablytic</title>
  <link rel="canonical" href="https://grablytic.vercel.app/404" />
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
  <link rel="icon" href="/logo.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
</head>
<body class="bg-(--color-paper-base) text-(--color-ink) antialiased">
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Nav base="/" />
  <main id="main-content" class="pt-28 pb-20 px-4 max-w-xl mx-auto text-center">
    <img src="/logo.png" alt="Grablytic logo" width="72" height="72" class="w-[72px] h-[72px] rounded-full mx-auto mb-6 border border-(--color-line)/50" />
    <span class="eyebrow mb-2 inline-block">404 · lost in the bazaar</span>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">That shelf does not exist.</h1>
    <p class="text-sm sm:text-base text-(--color-ink-muted) mt-3 max-w-[65ch] mx-auto">
      The page moved or never existed. Grab the app, browse the docs, or head back home.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn-primary">Back home</a>
      <a href="/docs/" class="btn-secondary">Browse docs</a>
    </div>
  </main>
  <Footer />
</body>
</html>
