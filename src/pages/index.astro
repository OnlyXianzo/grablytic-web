---
import '../styles/global.css';
import Nav from '../sections/Nav.astro';
import Hero from '../sections/Hero.astro';
import Showcase from '../sections/Showcase.astro';
import Features from '../sections/Features.astro';
import Downloads from '../sections/Downloads.astro';
import Faq from '../sections/Faq.astro';
import Community from '../sections/Community.astro';
import Footer from '../sections/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="TrueStream — privacy-first, high-performance media extractor. Download audio and video in highest fidelity from 1,000+ platforms." />
  <title>TrueStream — Privacy-First Media Extractor</title>
  <link rel="icon" href="/logo.png" />
</head>
<body>
  <Nav />
  <main>
    <Hero />
    <Showcase />
    <Features />
    <Downloads />
    <Faq />
    <Community />
  </main>
  <Footer />

  <script>
    import { initHeroAnimation, initScrollReveals, initCountUps, initMagneticButtons, initOrbParallax } from '../lib/gsap.ts';
    initHeroAnimation();
    initScrollReveals();
    initCountUps();
    initMagneticButtons();
    initOrbParallax();

    // Showcase converge-and-glow trigger (CSS does the motion).
    (function () {
      const s = document.getElementById('showcase');
      if (!s) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        s.classList.add('inview');
        return;
      }
      const o = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { s.classList.add('inview'); o.disconnect(); }
      }, { threshold: 0.25 });
      o.observe(s);
    })();
  </script>
</body>
</html>
