  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script>
  // Luxury motion: hero timeline, scroll reveals, counters, magnetic buttons, orb parallax.
  (function(){if(window.matchMedia('(prefers-reduced-motion: reduce)').matches||!window.gsap)return;
  gsap.registerPlugin(ScrollTrigger);
  gsap.timeline({defaults:{ease:'power3.out'}})
    .from('[data-hero="logo"]',{scale:.4,opacity:0,duration:.7,ease:'back.out(1.6)'})
    .from('[data-hero="title"]',{y:44,opacity:0,duration:.8},'-=.35')
    .from('[data-hero="sub"]',{y:28,opacity:0,duration:.6},'-=.5')
    .from('[data-hero="cta"] .btn',{y:20,opacity:0,stagger:.1,duration:.5},'-=.35')
    .from('[data-hero="cta2"] .btn',{y:16,opacity:0,stagger:.1,duration:.45},'-=.3')
    .from('[data-hero="badges"] span',{y:12,opacity:0,stagger:.08,duration:.4},'-=.3')
    .from('[data-hero="stats"]',{opacity:0,duration:.5},'-=.2');
  gsap.utils.toArray('[data-reveal]').forEach(function(el){
    gsap.from(el,{y:36,opacity:0,duration:.7,ease:'power3.out',
      scrollTrigger:{trigger:el,start:'top 88%',once:true}});});
  document.querySelectorAll('[data-count]').forEach(function(el){
    var end=+el.dataset.count,o={v:0};
    ScrollTrigger.create({trigger:el,start:'top 92%',once:true,onEnter:function(){
      gsap.to(o,{v:end,duration:1.4,ease:'power2.out',onUpdate:function(){el.textContent=Math.round(o.v);}});}});});
  document.querySelectorAll('.btn-p').forEach(function(b){
    b.addEventListener('mousemove',function(e){var r=b.getBoundingClientRect();
      gsap.to(b,{x:(e.clientX-r.left-r.width/2)*.18,y:(e.clientY-r.top-r.height/2)*.28,duration:.3});});
    b.addEventListener('mouseleave',function(){gsap.to(b,{x:0,y:0,duration:.5,ease:'elastic.out(1,.5)'});});});
  window.addEventListener('mousemove',function(e){
    var x=(e.clientX/window.innerWidth-.5),y=(e.clientY/window.innerHeight-.5);
    gsap.to('.orb.a',{x:x*50,y:y*40,duration:1.2});gsap.to('.orb.b',{x:x*-60,y:y*-50,duration:1.4});});
  })();
  </script>
  <script>
  // <2KB OS/arch router (userAgentData + userAgent fallback)
  (function(){var b=document.getElementById('dl-primary'),d=navigator.userAgentData||{},ua=navigator.userAgent||'';
  var mob=d.mobile||/Android|Mobile/i.test(ua),plat=(d.platform||'').toLowerCase();
  function apk(f,l){b.href='https://github.com/OnlyXianzo/TrueStream/releases/download/v0.0.1/'+f;b.textContent=l;}
  if(mob||/android/i.test(ua)){if(/armv7|armeabi/i.test(ua))apk('truestream-v0.0.1-armv7-node.apk','Download for Android (32-bit)');else if(/x86_64|x86/i.test(ua))apk('truestream-v0.0.1-x86_64-deno.apk','Download for Android (x86_64)');else apk('truestream-v0.0.1-arm64-deno.apk','Download for Android (arm64)');}
  else if(/win/i.test(plat)||/windows/i.test(ua)){b.href='https://github.com/OnlyXianzo/TrueStream/releases/download/v0.0.1/truestream-windows-x64.zip';b.textContent='Download for Windows (x64)';}
  else if(/linux/i.test(plat)||/linux/i.test(ua)){b.href='https://github.com/OnlyXianzo/TrueStream/releases/download/v0.0.1/truestream-0.0.1-linux-x64.tar.gz';b.textContent='Download for Linux (x64)';}
  else{b.textContent='Download (all platforms below)';b.href='https://github.com/OnlyXianzo/TrueStream/releases/latest';}})();
  </script>
  <script>
  // Showcase: single IntersectionObserver, CSS does the motion (see verified-approach-showcase.md).
  (function(){var s=document.getElementById('showcase');if(!s)return;
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches||!('IntersectionObserver' in window)){s.classList.add('inview');return;}
  var o=new IntersectionObserver(function(e){if(e[0].isIntersecting){s.classList.add('inview');o.disconnect();}},{threshold:.25});
  o.observe(s);})();
  </script>
