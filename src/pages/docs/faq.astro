---
// src/pages/docs/faq.astro — Long-form user FAQ with FAQPage structured data.
import Nav from '../../sections/Nav.astro';
import Footer from '../../sections/Footer.astro';
import { REPO } from '../../data/downloads';
import { faqGroups as groups } from '../../data/faq-groups';
import '../../styles/global.css';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((g) =>
    g.items.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  ),
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Grablytic FAQ: pricing, supported platforms, APK choice, privacy, quality, playlists, resume, and updates — long-form answers for the free private media downloader." />
  <title>Grablytic FAQ — Free, Platforms, Privacy, Quality & More</title>
  <link rel="canonical" href="https://grablytic.vercel.app/docs/faq/" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#131313" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="Grablytic" />
  <meta property="og:url" content="https://grablytic.vercel.app/docs/faq/" />
  <meta property="og:title" content="Grablytic FAQ — Free, Platforms, Privacy, Quality & More" />
  <meta property="og:description" content="Long-form answers: cost, devices, APK choice, zero telemetry, quality ladders, playlists, resume, and updates." />
  <meta property="og:image" content="https://grablytic.vercel.app/og-image.jpg" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://grablytic.vercel.app/" },
      { "@type": "ListItem", "position": 2, "name": "Docs", "item": "https://grablytic.vercel.app/docs/" },
      { "@type": "ListItem", "position": 3, "name": "FAQ", "item": "https://grablytic.vercel.app/docs/faq/" }
    ]
  }
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/logo.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" /></noscript>
</head>
<body class="bg-(--color-paper-base) text-(--color-ink) antialiased selection:bg-(--color-terracotta-container)/30 selection:text-(--color-terracotta)">
  <Nav base="/" />
  <main id="main-content" class="pt-28 pb-20 px-4 max-w-4xl mx-auto">
    <nav aria-label="Breadcrumb" class="text-xs text-(--color-ink-faint) mb-6">
      <a href="/" class="hover:text-(--color-ink) transition-colors">Home</a>
      <span aria-hidden="true" class="mx-1.5">/</span>
      <a href="/docs/" class="hover:text-(--color-ink) transition-colors">Docs</a>
      <span aria-hidden="true" class="mx-1.5">/</span>
      <span aria-current="page" class="text-(--color-ink-muted)">FAQ</span>
    </nav>

    <span class="eyebrow mb-2 inline-block">Long-form answers</span>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Frequently asked questions</h1>
    <p class="text-sm sm:text-base text-(--color-ink-muted) mt-3 max-w-2xl">
      Straight answers on cost, devices, privacy, quality, and updates.
      For step-by-step installation see the <a href="/docs/install/" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">install guide</a>;
      for fixes see <a href="/docs/troubleshooting/" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">troubleshooting</a>.
    </p>

    {groups.map((group) => (
      <section class="mt-10">
        <h2 class="text-xl font-bold tracking-tight mb-4">{group.heading}</h2>
        <div class="space-y-3">
          {group.items.map((faq) => (
            <details class="faq-item group">
              <summary class="text-(--color-ink) text-base sm:text-lg font-semibold">
                <span>{faq.q}</span>
              </summary>
              <div class="faq-panel"><div class="faq-panel-inner">
              <p class="mt-3 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed pt-3 border-t border-(--color-tile-highest)">
                {faq.a}
              </p>
              </div></div>
            </details>
          ))}
        </div>
      </section>
    ))}

    <p class="mt-12 text-xs text-(--color-ink-faint)">
      Question not covered? <a href={`${REPO}/issues`} class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">Ask on GitHub</a>
      or check <a href="/docs/troubleshooting/" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">troubleshooting</a>.
    </p>
  </main>
  <Footer />
</body>
</html>
