---
// src/pages/docs/install.astro — Per-OS install guide with live release links.
import Nav from '../../sections/Nav.astro';
import Footer from '../../sections/Footer.astro';
import TerminalBlock from '../../components/TerminalBlock.astro';
import { TAG, REL, REPO, androidDownloads, linuxDownloads, windowsDownloads } from '../../data/downloads';
import '../../styles/global.css';

function formatMB(bytes: number): string {
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Install Grablytic on Android, Linux & Windows: pick the right APK variant (Deno vs Node), .deb/.rpm/Arch packages, or portable Windows zip. Verify SHA-256 checksums." />
  <title>Install Grablytic — Android, Linux & Windows Setup Guide</title>
  <link rel="canonical" href="https://grablytic.vercel.app/docs/install/" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#131313" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="Grablytic" />
  <meta property="og:url" content="https://grablytic.vercel.app/docs/install/" />
  <meta property="og:title" content="Install Grablytic — Android, Linux & Windows Setup Guide" />
  <meta property="og:description" content="Pick the right APK, Linux package, or Windows zip. Verify checksums and finish first-launch setup." />
  <meta property="og:image" content="https://grablytic.vercel.app/og-image.jpg" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://grablytic.vercel.app/" },
      { "@type": "ListItem", "position": 2, "name": "Docs", "item": "https://grablytic.vercel.app/docs/" },
      { "@type": "ListItem", "position": 3, "name": "Install", "item": "https://grablytic.vercel.app/docs/install/" }
    ]
  }
  </script>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/logo.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" /></noscript>
</head>
<body class="bg-(--color-paper-base) text-(--color-ink) antialiased selection:bg-(--color-terracotta-container)/30 selection:text-(--color-terracotta)">
  <Nav base="/" />
  <main id="main-content" class="pt-28 pb-20 px-4 max-w-4xl mx-auto">
    <nav aria-label="Breadcrumb" class="text-xs text-(--color-ink-faint) mb-6">
      <a href="/" class="hover:text-(--color-ink) transition-colors">Home</a>
      <span aria-hidden="true" class="mx-1.5">/</span>
      <a href="/docs/" class="hover:text-(--color-ink) transition-colors">Docs</a>
      <span aria-hidden="true" class="mx-1.5">/</span>
      <span aria-current="page" class="text-(--color-ink-muted)">Install</span>
    </nav>

    <span class="eyebrow mb-2 inline-block">Guide · {TAG}</span>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Install Grablytic</h1>
    <p class="text-sm sm:text-base text-(--color-ink-muted) mt-3 max-w-2xl">
      Grablytic runs on Android 8+, Windows 10/11, and modern Linux. Everything below
      comes from official GitHub Releases — never install APKs or binaries from third-party mirrors.
    </p>

    <section id="android" class="mt-12 scroll-mt-28">
      <span class="eyebrow mb-2 inline-block">Android 8+ · API 26+</span>
      <h2 class="text-2xl font-bold tracking-tight">Choose your APK</h2>
      <div class="paper-tile p-5 sm:p-6 mt-6 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed">
        <p>
          <strong class="text-(--color-ink)">Most phones (2020+):</strong> pick the
          <strong class="text-(--color-ink)">arm64 + Deno</strong> APK — Deno is yt-dlp's recommended
          JS runtime (sandboxed, fastest challenge solving). The
          <strong class="text-(--color-ink)">arm64 + Node.js</strong> variant does the same job in a
          ~40 MB smaller download. Budget 32-bit devices take the armv7 Node build; Chromebooks
          and emulators take x86_64. Unsure? The <strong class="text-(--color-ink)">universal</strong> APK
          bundles every ABI and both runtimes (458 MB). Wondering why the files are this big at all?
          The <a href="/docs/faq/" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">FAQ explains the engine</a> — yt-dlp, the JS runtimes, and why Android must bundle it all.
        </p>
        <div id="obtainium" class="mt-3 scroll-mt-28 rounded-lg border border-(--color-line)/30 bg-(--color-tile)/60 p-4">
          <p class="font-semibold text-(--color-ink)">Easiest path (Android-only): Obtainium</p>
          <ol class="mt-2 space-y-1.5 list-decimal pl-5">
            <li>Install <a href="https://github.com/ImranR98/Obtainium/releases" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">Obtainium</a> on your phone first.</li>
            <li>On your phone, tap <a href="https://apps.obtainium.imranr.dev/redirect?r=obtainium%3A%2F%2Fapp%2Fhttps%3A%2F%2Fgithub.com%2FOnlyXianzo%2FGrablytic" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">add Grablytic to Obtainium</a> and confirm — or in Obtainium use Add App and paste <code class="font-mono text-(--color-terracotta)">https://github.com/OnlyXianzo/Grablytic</code>.</li>
            <li>Done: future releases arrive as automatic updates, straight from GitHub — no store, no account.</li>
          </ol>
          <p class="mt-2 text-(--color-ink-faint)">On a desktop browser? This button links here instead — Obtainium itself runs on Android only.</p>
        </div>
      </div>
      <div class="mt-4 space-y-3">
        {androidDownloads.map((item) => (
          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3.5 rounded-lg bg-(--color-tile) border border-(--color-line)/30">
            <div class="mb-2 sm:mb-0">
              <span class="text-sm font-semibold text-(--color-ink) block">{item.label}</span>
              <span class="text-xs text-(--color-ink-muted)">{item.file} · {formatMB(item.size)}</span>
              <span class="text-xs font-mono text-(--color-ink-faint) block mt-0.5 truncate max-w-sm sm:max-w-md" title={item.sha256}>SHA256: {item.sha256.substring(0, 16)}…</span>
            </div>
            <a href={`${REL}/${item.file}`} class="inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-lg bg-(--color-terracotta-container)/15 text-(--color-terracotta) border border-(--color-terracotta-container)/30 hover:bg-(--color-terracotta-container) hover:text-white transition w-fit">Download .apk</a>
          </div>
        ))}
      </div>
      <ol class="mt-6 space-y-3 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed list-none p-0">
        <li class="paper-tile p-5"><strong class="text-(--color-ink)">1. Allow installs.</strong> Open the APK — Android will ask you to allow installs from your browser or file manager. Grant it once.</li>
        <li class="paper-tile p-5"><strong class="text-(--color-ink)">2. Install &amp; open.</strong> FFmpeg and the JS runtime ship inside the APK, so there is nothing else to download. Grant storage/media access when asked.</li>
        <li class="paper-tile p-5"><strong class="text-(--color-ink)">3. Check readiness.</strong> Open Settings → Diagnostics &amp; Logs and confirm the engine reports healthy before your first download.</li>
        <li class="paper-tile p-5"><strong class="text-(--color-ink)">4. Exempt from battery optimization.</strong> So background downloads survive screen lock: system Settings → Apps → Grablytic → Battery → Unrestricted (wording varies by vendor).</li>
      </ol>
    </section>

    <section id="linux" class="mt-12 scroll-mt-28">
      <span class="eyebrow mb-2 inline-block">Linux · x64 &amp; arm64</span>
      <h2 class="text-2xl font-bold tracking-tight">Install on Linux</h2>
      <div class="paper-tile p-5 sm:p-6 mt-6 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed space-y-3">
        <p class="font-semibold text-(--color-ink)">Zero decisions — one command:</p>
        <TerminalBlock
          command="curl -fsSL https://raw.githubusercontent.com/OnlyXianzo/Grablytic/main/install.sh | bash"
          copyLabel="Copy Linux installer command"
          verifyHref="#verify"
          verifyText="Verify checksums before running"
        />
        <p>The script auto-detects your distro (apt/dnf/zypper/pacman) and architecture (x64/arm64), verifies SHA-256 checksums, and installs natively. Prefer manual control? The per-family equivalents below fetch the same assets.</p>
      </div>
      <div class="mt-4 space-y-3">
        {linuxDownloads.map((item) => (
          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3.5 rounded-lg bg-(--color-tile) border border-(--color-line)/30">
            <div class="mb-2 sm:mb-0">
              <span class="text-sm font-semibold text-(--color-ink) block">{item.label}</span>
              <span class="text-xs text-(--color-ink-muted)">{item.file} · {formatMB(item.size)}</span>
            </div>
            <a href={`${REL}/${item.file}`} class="inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-lg bg-(--color-terracotta-container)/15 text-(--color-terracotta) border border-(--color-terracotta-container)/30 hover:bg-(--color-terracotta-container) hover:text-white transition w-fit">Download</a>
          </div>
        ))}
      </div>
      <div class="paper-tile p-5 sm:p-6 mt-4 text-xs sm:text-sm text-(--color-ink-muted) space-y-4">
        <div>
          <p class="font-semibold text-(--color-ink) mb-1">Debian / Ubuntu / Mint (apt resolves dependencies):</p>
          <code class="text-(--color-terracotta) block overflow-x-auto select-all font-mono">curl -LO {REL}/grablytic_0.0.2_amd64.deb &amp;&amp; sudo apt install ./grablytic_0.0.2_amd64.deb</code>
          <p class="font-mono text-(--color-ink-faint) mt-2">arm64: curl -LO {REL}/grablytic_0.0.2_arm64.deb &amp;&amp; sudo apt install ./grablytic_0.0.2_arm64.deb</p>
        </div>
        <div>
          <p class="font-semibold text-(--color-ink) mb-1">Fedora / RHEL / openSUSE:</p>
          <code class="text-(--color-terracotta) block overflow-x-auto select-all font-mono">sudo dnf install {REL}/grablytic-0.0.2-1.x86_64.rpm</code>
        </div>
        <div>
          <p class="font-semibold text-(--color-ink) mb-1">Arch / Manjaro / EndeavourOS:</p>
          <code class="text-(--color-terracotta) block overflow-x-auto select-all font-mono">sudo pacman -U {REL}/grablytic-0.0.2-1-x86_64.pkg.tar.zst</code>
        </div>
        <div>
          <p class="font-semibold text-(--color-ink) mb-1">Portable tarball (any distro):</p>
          <code class="text-(--color-terracotta) block overflow-x-auto select-all font-mono">tar xzf grablytic-0.0.2-linux-x64.tar.gz</code>
        </div>
      </div>
    </section>

    <section id="windows" class="mt-12 scroll-mt-28">
      <span class="eyebrow mb-2 inline-block">Windows 10 / 11 · x64</span>
      <h2 class="text-2xl font-bold tracking-tight">Install on Windows</h2>
      <div class="mt-4 space-y-3">
        {windowsDownloads.map((item) => (
          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3.5 rounded-lg bg-(--color-tile) border border-(--color-line)/30">
            <div class="mb-2 sm:mb-0">
              <span class="text-sm font-semibold text-(--color-ink) block">{item.label}</span>
              <span class="text-xs text-(--color-ink-muted)">{item.file} · {formatMB(item.size)}</span>
            </div>
            <a href={`${REL}/${item.file}`} class="inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-lg bg-(--color-terracotta-container)/15 text-(--color-terracotta) border border-(--color-terracotta-container)/30 hover:bg-(--color-terracotta-container) hover:text-white transition w-fit">Download .zip</a>
          </div>
        ))}
      </div>
      <div class="paper-tile p-5 sm:p-6 mt-4 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed">
        <p>Unzip anywhere (e.g. <code class="font-mono text-(--color-terracotta)">%LOCALAPPDATA%\Grablytic</code>) and run the app — no installer, no admin rights. On first launch the bootstrapper fetches FFmpeg and the Deno runtime automatically, each SHA-256 verified. (WinGet submission for <code class="font-mono text-(--color-terracotta)">OnlyXianzo.Grablytic</code> is pending — not installable yet.)</p>
      </div>
    </section>

    <section id="updates" class="mt-12 scroll-mt-28">
      <span class="eyebrow mb-2 inline-block">Never fall behind</span>
      <h2 class="text-2xl font-bold tracking-tight">Staying updated</h2>
      <div class="paper-tile p-5 sm:p-6 mt-6 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed space-y-3">
        <p><strong class="text-(--color-ink)">Android:</strong> Obtainium updates the app automatically from GitHub Releases. Engine binaries (FFmpeg, JS runtime) ride app updates — Android forbids executing downloaded files, so there is no separate engine updater.</p>
        <p><strong class="text-(--color-ink)">Desktop:</strong> yt-dlp and engine components update silently with integrity checks. Feeling adventurous? Switch tracks (stable / nightly / master) in Settings → Updates.</p>
        <p><strong class="text-(--color-ink)">Linux packages:</strong> re-run the one-command installer or your manager's upgrade path to move to a new release.</p>
      </div>
    </section>

    <section id="verify" class="mt-12 scroll-mt-28">
      <span class="eyebrow mb-2 inline-block">Trust, then run</span>
      <h2 class="text-2xl font-bold tracking-tight">Verify your download</h2>
      <div class="paper-tile p-5 sm:p-6 mt-6 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed space-y-3">
        <p>Every release asset above ships with a published SHA-256 checksum (hover any truncated hash to see the prefix; full values live in the release notes). Compare before installing:</p>
        <code class="text-(--color-terracotta) block overflow-x-auto select-all font-mono">sha256sum grablytic-*  # Linux · compare against the value shown above</code>
        <p class="font-mono text-(--color-ink-faint)">Android: check the APK hash in a file manager or via `sha256sum` in Termux. Windows: `Get-FileHash file.zip -Algorithm SHA256` in PowerShell.</p>
        <p>If a hash mismatches, delete the file and re-download from <a href={`${REPO}/releases/latest`} class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">GitHub Releases</a> — never run it.</p>
      </div>
    </section>

    <section id="migrate" class="mt-12 scroll-mt-28">
      <span class="eyebrow mb-2 inline-block">TrueStream → Grablytic</span>
      <h2 class="text-2xl font-bold tracking-tight">Coming from TrueStream?</h2>
      <div class="paper-tile p-5 sm:p-6 mt-6 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed space-y-3">
        <p>Android treats Grablytic as a new app, so install it alongside TrueStream, verify it works, then uninstall the old app. App-private settings and history do not carry over — but your files are safe:</p>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong class="text-(--color-ink)">Your downloads stay put.</strong> Fresh installs default to <code class="font-mono text-(--color-terracotta)">Download/Grablytic</code>, but if a legacy <code class="font-mono text-(--color-terracotta)">Download/TrueStream</code> folder already exists it keeps being used automatically — nothing is moved or deleted.</li>
          <li><strong class="text-(--color-ink)">Linux upgrades cleanly.</strong> The <code class="font-mono text-(--color-terracotta)">.deb</code> replaces the old <code class="font-mono text-(--color-terracotta)">truestream</code> package automatically; remove any manually installed v0.0.1 package yourself only if your manager doesn't.</li>
          <li><strong class="text-(--color-ink)">Old release files keep working.</strong> v0.0.1 assets intentionally keep their original <code class="font-mono text-(--color-terracotta)">truestream-*</code> names and checksums; new releases use <code class="font-mono text-(--color-terracotta)">grablytic-*</code> names.</li>
        </ul>
      </div>
    </section>

    <p class="mt-12 text-xs text-(--color-ink-faint)">
      Next: <a href="/docs/features/" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">learn the features</a>
      · <a href="/docs/faq/" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">read the FAQ</a>
      · <a href="/docs/troubleshooting/" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">fix a problem</a>
    </p>
  </main>
  <Footer />
</body>
</html>
