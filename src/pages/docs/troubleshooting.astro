---
// src/pages/docs/troubleshooting.astro — Symptom → fix guide distilled from
// the app's docs/troubleshooting.md (user-facing only).
import Nav from '../../sections/Nav.astro';
import Footer from '../../sections/Footer.astro';
import { REPO } from '../../data/downloads';
import '../../styles/global.css';

interface Row { symptom: string; cause: string; fix: string }

const rows: Row[] = [
  {
    symptom: 'YouTube downloads fail (signature / challenge errors)',
    cause: 'Missing or unhealthy JS runtime.',
    fix: 'Open Settings → Diagnostics & Logs: js_runtime must read deno or quickjs. Re-run setup; on desktop check network access for the runtime fetch; on Android reinstall the full APK (contributor builds without bundled natives have no runtime).',
  },
  {
    symptom: 'Downloads are slow on small fragments',
    cause: 'Parallel fetching off, or a DASH/HLS source.',
    fix: 'Enable aria2c on Wi-Fi and raise chunks (max 16). Note: DASH/HLS streams always use the native downloader by design — that is expected, not a bug.',
  },
  {
    symptom: 'Progress sticks at 99%',
    cause: 'Post-processing stage (merge / embed / chapters).',
    fix: 'By design: streaming progress caps at 99% and only the terminal finished event reports 100%. Watch the live log for the post-processing stage instead of restarting.',
  },
  {
    symptom: 'Video engine (FFmpeg) reports missing on Android',
    cause: 'Incomplete install — the APK on your device lacks bundled native binaries.',
    fix: 'Reinstall the full APK from GitHub Releases (all variants ship FFmpeg inside — never copy library files around manually). Alternatively set a custom FFmpeg path in Settings if you maintain your own build.',
  },
  {
    symptom: 'A finished download never completes',
    cause: 'Stale app version missing the completion-event fix.',
    fix: 'Update to the latest release — completion events are now delivered reliably even when the app polls slowly. Then check the per-download log to confirm the file landed.',
  },
  {
    symptom: 'Chapters are not cut after SponsorBlock runs',
    cause: 'Empty SponsorBlock categories, or embedding order confusion.',
    fix: 'Make sure at least one SponsorBlock category (sponsor, intro, outro…) is enabled — with none selected there is nothing to cut. The cutter order (subtitles → chapters → metadata) is automatic; just re-run the item.',
  },
  {
    symptom: 'Geo-blocked / rate-limited errors',
    cause: 'Region restriction or IP throttling.',
    fix: 'The error card says when a VPN helps — follow its hint. Alternatives: a proxy, geo-bypass, a sleep interval between requests, or cookie login for your region.',
  },
  {
    symptom: 'Resume finds nothing after a restart',
    cause: 'Expired or misplaced partial files.',
    fix: 'Only .part files with metadata younger than 24h in the cache directory qualify. Verify the cache directory path in settings before retrying.',
  },
  {
    symptom: 'Subtitles download but are not in the file',
    cause: 'Embedding switched off.',
    fix: 'Turn on subtitle embedding in settings and confirm FFmpeg reports healthy in Diagnostics.',
  },
  {
    symptom: 'Downloads stall in background (Android)',
    cause: 'Battery optimization killing the process.',
    fix: 'Exempt Grablytic from battery optimization so the keep-alive service survives. Downloads degrade gracefully rather than crash, and resume on next launch.',
  },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Fix Grablytic problems: YouTube failures, slow fragments, stuck-at-99%, geo-blocks, resume, subtitles, and background stalls. Symptom-to-fix troubleshooting guide." />
  <title>Grablytic Troubleshooting — Fix Failed, Slow & Stuck Downloads</title>
  <link rel="canonical" href="https://grablytic.vercel.app/docs/troubleshooting/" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#131313" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="Grablytic" />
  <meta property="og:url" content="https://grablytic.vercel.app/docs/troubleshooting/" />
  <meta property="og:title" content="Grablytic Troubleshooting — Fix Failed, Slow & Stuck Downloads" />
  <meta property="og:description" content="Symptom-to-fix guide: YouTube errors, slow fragments, 99% stalls, geo-blocks, resume, and log export." />
  <meta property="og:image" content="https://grablytic.vercel.app/og-image.jpg" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://grablytic.vercel.app/" },
      { "@type": "ListItem", "position": 2, "name": "Docs", "item": "https://grablytic.vercel.app/docs/" },
      { "@type": "ListItem", "position": 3, "name": "Troubleshooting", "item": "https://grablytic.vercel.app/docs/troubleshooting/" }
    ]
  }
  </script>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/logo.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" /></noscript>
</head>
<body class="bg-(--color-paper-base) text-(--color-ink) antialiased selection:bg-(--color-terracotta-container)/30 selection:text-(--color-terracotta)">
  <Nav base="/" />
  <main id="main-content" class="pt-28 pb-20 px-4 max-w-4xl mx-auto">
    <nav aria-label="Breadcrumb" class="text-xs text-(--color-ink-faint) mb-6">
      <a href="/" class="hover:text-(--color-ink) transition-colors">Home</a>
      <span aria-hidden="true" class="mx-1.5">/</span>
      <a href="/docs/" class="hover:text-(--color-ink) transition-colors">Docs</a>
      <span aria-hidden="true" class="mx-1.5">/</span>
      <span aria-current="page" class="text-(--color-ink-muted)">Troubleshooting</span>
    </nav>

    <span class="eyebrow mb-2 inline-block">Symptom → fix</span>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Troubleshooting</h1>
    <p class="text-sm sm:text-base text-(--color-ink-muted) mt-3 max-w-2xl">
      First step for almost everything: open <strong class="text-(--color-ink)">Settings → Diagnostics &amp; Logs</strong>
      and check engine health plus the live log stream. Then match your symptom below.
    </p>

    <div class="mt-8 space-y-4">
      {rows.map((r) => (
        <details class="faq-item group">
          <summary class="text-(--color-ink) text-base sm:text-lg font-semibold">
            <span>{r.symptom}</span>
          </summary>
          <div class="faq-panel"><div class="faq-panel-inner">
          <div class="mt-3 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed pt-3 border-t border-(--color-tile-highest) space-y-2">
            <p><strong class="text-(--color-ink)">Likely cause:</strong> {r.cause}</p>
            <p><strong class="text-(--color-ink)">Fix:</strong> {r.fix}</p>
          </div>
          </div></div>
        </details>
      ))}
    </div>

    <section class="mt-12">
      <span class="eyebrow mb-2 inline-block">Where logs live</span>
      <h2 class="text-2xl font-bold tracking-tight">Log locations</h2>
      <div class="paper-tile p-5 sm:p-6 mt-4 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed space-y-3">
        <p>
          The app keeps two persistent logs: the interface log (flushed every 30 seconds, instantly on
          errors) and the engine log (rotating file). Both are viewable live with level and text filters
          in <strong class="text-(--color-ink)">Settings → Diagnostics &amp; Logs → Live Stream</strong>.
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong class="text-(--color-ink)">Android exports</strong> land in the app's external <code class="font-mono text-(--color-terracotta)">log-exports/</code> folder — no extra permission needed.</li>
          <li><strong class="text-(--color-ink)">Desktop exports</strong> land in <code class="font-mono text-(--color-terracotta)">~/Downloads/Grablytic-logs/</code>.</li>
        </ul>
      </div>
    </section>

    <section class="mt-12">
      <span class="eyebrow mb-2 inline-block">Reporting a bug</span>
      <h2 class="text-2xl font-bold tracking-tight">Export your logs</h2>
      <div class="paper-tile p-5 sm:p-6 mt-4 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed space-y-3">
        <p>
          Use the <strong class="text-(--color-ink)">Export log file</strong> button in Diagnostics &amp; Logs
          (toggle <strong class="text-(--color-ink)">Include full log</strong> for stubborn issues — it attaches
          up to 512 KB instead of the 100 KB tail). Tokens and signatures are redacted automatically.
          Attach the export to your <a href={`${REPO}/issues`} class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">GitHub issue</a> —
          duplicate crashes may already be auto-filed and deduplicated.
        </p>
      </div>
    </section>

    <p class="mt-12 text-xs text-(--color-ink-faint)">
      Related: <a href="/docs/faq/" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">FAQ</a>
      · <a href="/docs/install/" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">reinstall cleanly</a>
      · <a href="/docs/" class="text-(--color-terracotta) hover:text-white transition-colors underline underline-offset-2">docs hub</a>
    </p>
  </main>
  <Footer />
</body>
</html>
