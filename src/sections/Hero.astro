---
// src/sections/Hero.astro — Hero section with dynamic OS download router and entrance motion
import stats from '../data/stats.json';
import { TAG, REL, REPO } from '../data/downloads';
---

<header class="pt-32 pb-16 px-4 max-w-5xl mx-auto text-center flex flex-col items-center" id="top">
  <div class="mb-6 relative group" data-hero="logo">
    <div class="absolute -inset-2 bg-gradient-to-r from-blue-600 to-purple-600 rounded-3xl blur-xl opacity-40 group-hover:opacity-60 transition duration-500"></div>
    <img src="/logo.png" alt="TrueStream Logo" width="112" height="112" class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-3xl shadow-2xl border border-white/10" />
  </div>

  <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white max-w-3xl leading-[1.15]" data-hero="title">
    Media that moves you.<br />
    <span class="bg-gradient-to-r from-blue-400 via-sky-300 to-indigo-300 bg-clip-text text-transparent">No ads. No tracking.</span>
  </h1>

  <p class="mt-6 text-base sm:text-lg text-zinc-400 max-w-2xl font-normal leading-relaxed" data-hero="sub">
    TrueStream is a free, privacy-first media extractor for Android, Linux, and Windows — highest fidelity from 1,000+ platforms with 100% local device processing.
  </p>

  <div class="mt-8 flex flex-wrap items-center justify-center gap-3 w-full max-w-md" data-hero="cta">
    <a id="dl-primary" class="btn-primary btn-magnetic w-full sm:w-auto" href={`${REL}/truestream-v0.0.1-arm64-deno.apk`}>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
      <span>Download</span>
    </a>
    <a class="btn-secondary btn-magnetic w-full sm:w-auto" href={REPO} target="_blank" rel="noopener noreferrer">
      <svg class="w-5 h-5 mr-2 text-zinc-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
      </svg>
      <span>View Source</span>
    </a>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-center gap-3" data-hero="cta2">
    <a class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/60 text-zinc-400 hover:text-white hover:border-zinc-700 transition" href="obtainium://app/https://github.com/OnlyXianzo/TrueStream">
      ✦ Add to Obtainium
    </a>
    <button class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/60 text-zinc-400 hover:text-white hover:border-zinc-700 transition cursor-pointer" onclick="document.getElementById('donate-dialog')?.showModal()">
      ♥ Support TrueStream
    </button>
  </div>

  <div class="mt-6 flex flex-wrap justify-center gap-2" data-hero="badges">
    <span class="inline-flex items-center text-xs px-3 py-1 rounded-full border border-blue-500/20 bg-blue-500/5 text-blue-300">
      100% Open Source (GPL-3.0)
    </span>
    <span class="inline-flex items-center text-xs px-3 py-1 rounded-full border border-emerald-500/20 bg-emerald-500/5 text-emerald-300">
      Zero Telemetry
    </span>
    <span class="inline-flex items-center text-xs px-3 py-1 rounded-full border border-zinc-700 bg-zinc-800/40 text-zinc-300">
      {TAG} Beta
    </span>
  </div>

  <div class="mt-10 grid grid-cols-3 gap-4 sm:gap-8 max-w-lg w-full pt-8 border-t border-zinc-800/80" data-hero="stats">
    <div class="text-center">
      <b class="block text-2xl sm:text-3xl font-bold text-white tracking-tight">1,000+</b>
      <span class="text-xs sm:text-sm text-zinc-400">platforms supported</span>
    </div>
    <div class="text-center">
      <b class="block text-2xl sm:text-3xl font-bold text-white tracking-tight">
        <span data-count={stats.binaries}>{stats.binaries}</span>
      </b>
      <span class="text-xs sm:text-sm text-zinc-400">release binaries</span>
    </div>
    <div class="text-center">
      <b class="block text-2xl sm:text-3xl font-bold text-white tracking-tight">3</b>
      <span class="text-xs sm:text-sm text-zinc-400">operating systems</span>
    </div>
  </div>
</header>

<div class="marquee-container my-8" aria-hidden="true">
  <div class="marquee-track">
    <span>YouTube 4K/8K/HDR ✦ SoundCloud 320k ✦ Twitch ✦ TikTok ✦ Instagram ✦ Twitter/X ✦ Bilibili ✦ Bandcamp ✦ 1,000+ more via yt-dlp ✦&nbsp;</span>
    <span>YouTube 4K/8K/HDR ✦ SoundCloud 320k ✦ Twitch ✦ TikTok ✦ Instagram ✦ Twitter/X ✦ Bilibili ✦ Bandcamp ✦ 1,000+ more via yt-dlp ✦&nbsp;</span>
  </div>
</div>

<script>
  // Hardened OS/Architecture Router (ytdlnis pattern + navigator.userAgentData)
  (function() {
    const btn = document.getElementById('dl-primary');
    if (!btn) return;

    interface NavUADData {
      mobile?: boolean;
      platform?: string;
    }
    const d = ((navigator as unknown as { userAgentData?: NavUADData }).userAgentData) || {};
    const ua = navigator.userAgent || '';
    const mob = d.mobile || /Android|Mobile/i.test(ua);
    const plat = (d.platform || '').toLowerCase();
    const tag = 'v0.0.1';
    const base = `https://github.com/OnlyXianzo/TrueStream/releases/download/${tag}/`;

    function setBtn(file: string, label: string) {
      if (btn) {
        btn.setAttribute('href', base + file);
        const span = btn.querySelector('span');
        if (span) span.textContent = label;
      }
    }

    if (mob || /android/i.test(ua)) {
      if (/armv7|armeabi/i.test(ua)) {
        setBtn('truestream-v0.0.1-armv7-node.apk', 'Download for Android (32-bit)');
      } else if (/x86_64|x86/i.test(ua)) {
        setBtn('truestream-v0.0.1-x86_64-deno.apk', 'Download for Android (x86_64)');
      } else {
        setBtn('truestream-v0.0.1-arm64-deno.apk', 'Download for Android (arm64)');
      }
    } else if (/win/i.test(plat) || /windows/i.test(ua)) {
      setBtn('truestream-windows-x64.zip', 'Download for Windows (x64)');
    } else if (/linux/i.test(plat) || /linux/i.test(ua)) {
      setBtn('truestream-0.0.1-linux-x64.tar.gz', 'Download for Linux (x64)');
    } else {
      btn.setAttribute('href', 'https://github.com/OnlyXianzo/TrueStream/releases/latest');
      const span = btn.querySelector('span');
      if (span) span.textContent = 'Download (All Platforms)';
    }
  })();
</script>
