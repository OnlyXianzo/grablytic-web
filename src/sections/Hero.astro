---
// src/sections/Hero.astro — Curated Bazaar hero section with dynamic OS download router
import stats from '../data/stats.json';
import { TAG, REL, REPO } from '../data/downloads';
---

<header class="pt-[var(--nav-clearance)] pb-16 px-4 max-w-5xl mx-auto text-center flex flex-col items-center scroll-mt-[var(--nav-clearance)]" id="top">
  <div class="mb-4 inline-flex flex-wrap items-center justify-center gap-2" data-hero="badges">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1C1B1B] border border-[#54433F]/40 shadow-sm">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#B7CCB9] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#B7CCB9]"></span>
      </span>
      <span class="eyebrow-muted text-[11px]">LOCAL MEDIA EXTRACTION · ZERO TELEMETRY · GPL-3.0</span>
    </div>
    <a href="https://github.com/OnlyXianzo" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#1C1B1B] border border-[#54433F]/40 text-[11px] font-semibold text-[#D9C1BC] hover:text-[#E5E2E1] hover:border-[#FFB4A3]/50 transition">
      <span class="text-[#A28C87]">by</span>
      <span class="text-[#FFB4A3]">@OnlyXianzo</span>
    </a>
  </div>

  <div class="mb-6 relative group cursor-pointer transition-transform duration-300 hover:scale-105" data-hero="logo">
    <img src="/logo.png" alt="TrueStream Logo" width="104" height="104" class="w-24 h-24 sm:w-26 sm:h-26 rounded-3xl border border-[#54433F]/50 shadow-md group-hover:border-[#FFB4A3]/50 transition-colors" />
  </div>

  <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-[#E5E2E1] max-w-3xl leading-[1.12]" data-hero="title">
    Media that moves you.<br />
    <span class="text-[#FFB4A3]">No ads. No tracking.</span>
  </h1>

  <p class="mt-5 text-base sm:text-lg text-[#D9C1BC] max-w-2xl font-normal leading-relaxed" data-hero="sub">
    A curated, privacy-first media extractor for Android, Linux, and Windows — highest fidelity Opus/AAC streams from 1,000+ platforms with 100% local device execution.
  </p>

  <div class="mt-8 flex flex-wrap items-center justify-center gap-4 sm:gap-3 w-full max-w-lg" data-hero="cta">
    <a id="dl-primary" class="btn-primary btn-magnetic w-full sm:w-auto" href={`${REL}/truestream-v0.0.1-arm64-deno.apk`}>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
      <span>Download for Android (arm64)</span>
    </a>
    <a class="btn-secondary btn-magnetic w-full sm:w-auto flex items-center justify-center gap-2" href={REPO} target="_blank" rel="noopener noreferrer" aria-label={`Star TrueStream on GitHub (${stats.stars} stars)`}>
      <svg class="w-4 h-4 text-[#FFB4A3]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
      </svg>
      <span>Star on GitHub</span>
      <span class="ml-1 px-2 py-0.5 text-xs font-semibold rounded-full bg-[#9B503E]/25 text-[#FFB4A3] border border-[#9B503E]/40">★ {stats.stars}</span>
    </a>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-center gap-2.5" data-hero="cta2">
    <a class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-[#54433F]/40 bg-[#1C1B1B] text-[#D9C1BC] hover:text-[#E5E2E1] hover:border-[#FFB4A3]/50 transition inline-flex items-center gap-1.5" href="https://github.com/OnlyXianzo" target="_blank" rel="noopener noreferrer">
      <svg class="w-3.5 h-3.5 text-[#A28C87]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
      </svg>
      <span>+ Follow @OnlyXianzo</span>
    </a>
    <a id="obtainium-add" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-[#54433F]/40 bg-[#1C1B1B] text-[#D9C1BC] hover:text-[#E5E2E1] hover:border-[#54433F] transition inline-flex items-center gap-1.5" href="obtainium://app/https://github.com/OnlyXianzo/TrueStream">
      <span>✦ Add to Obtainium</span>
    </a>
    <button class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-[#54433F]/40 bg-[#1C1B1B] text-[#D9C1BC] hover:text-[#E5E2E1] hover:border-[#54433F] transition cursor-pointer inline-flex items-center gap-1.5" onclick="document.getElementById('donate-dialog')?.showModal()">
      <span>♥ Support TrueStream</span>
    </button>
  </div>

  <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 max-w-2xl w-full pt-8 border-t border-[#353534]" data-hero="stats">
    <div class="text-center">
      <b class="primary-value block">1,000+</b>
      <span class="text-xs text-[#D9C1BC]">supported platforms</span>
    </div>
    <div class="text-center">
      <b class="primary-value block">
        <span data-count={stats.binaries}>{stats.binaries}</span>
      </b>
      <span class="text-xs text-[#D9C1BC]">release binaries ({stats.latest_tag})</span>
    </div>
    <div class="text-center">
      <b class="primary-value block">3</b>
      <span class="text-xs text-[#D9C1BC]">operating systems</span>
    </div>
    <div class="text-center">
      <a href="https://github.com/OnlyXianzo/TrueStream" target="_blank" rel="noopener noreferrer" class="group block hover:opacity-90 transition">
        <b class="primary-value block flex items-center justify-center gap-1">
          <span class="text-lg text-[#FFB4A3]">★</span>
          <span data-count={stats.stars}>{stats.stars}</span>
        </b>
        <span class="text-xs text-[#D9C1BC] group-hover:text-[#FFB4A3] transition-colors">GitHub stars</span>
      </a>
    </div>
  </div>
</header>

<div class="marquee-container my-8" aria-hidden="true">
  <div class="marquee-track">
    <span>YouTube 4K/8K/HDR ✦ SoundCloud 320k ✦ Twitch ✦ TikTok ✦ Instagram ✦ Twitter/X ✦ Bilibili ✦ Bandcamp ✦ 1,000+ more via yt-dlp ✦&nbsp;</span>
    <span>YouTube 4K/8K/HDR ✦ SoundCloud 320k ✦ Twitch ✦ TikTok ✦ Instagram ✦ Twitter/X ✦ Bilibili ✦ Bandcamp ✦ 1,000+ more via yt-dlp ✦&nbsp;</span>
  </div>
</div>

<script>
  // Hardened OS/Architecture Router
  (function() {
    const btn = document.getElementById('dl-primary');
    if (!btn) return;

    interface NavUADData {
      mobile?: boolean;
      platform?: string;
    }
    const d = ((navigator as unknown as { userAgentData?: NavUADData }).userAgentData) || {};
    const ua = navigator.userAgent || '';
    const mob = d.mobile || /Android|Mobile/i.test(ua);
    const plat = (d.platform || '').toLowerCase();
    const tag = 'v0.0.1';
    const base = `https://github.com/OnlyXianzo/TrueStream/releases/download/${tag}/`;

    const icons = {
      android: `<svg class="w-4 h-4 mr-2 text-white shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.413 13.8564 8 12 8s-3.5902.413-5.1368 1.4507L4.841 5.9477a.416.416 0 00-.5676-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.693 0 15.659 0 20.25h24c0-4.591-2.6889-8.557-6.1185-10.9286"/></svg>`,
      linux: `<svg class="w-4 h-4 mr-2 text-white shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139zm.529 3.405h.013c.213 0 .396.062.584.198.19.135.33.332.438.533.105.259.158.459.166.724 0-.02.006-.04.006-.06v.105a.086.086 0 01-.004-.021l-.004-.024a1.807 1.807 0 01-.15.706.953.953 0 01-.213.335.71.71 0 00-.088-.042c-.104-.045-.198-.064-.284-.133a1.312 1.312 0 00-.22-.066c.05-.06.146-.133.183-.198.053-.128.082-.264.088-.402v-.02a1.21 1.21 0 00-.061-.4c-.045-.134-.101-.2-.183-.333-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 00-.205.334 1.18 1.18 0 00-.09.4v.019c.002.089.008.179.02.267-.193-.067-.438-.135-.607-.202a1.635 1.635 0 01-.018-.2v-.02a1.772 1.772 0 01.15-.768c.082-.22.232-.406.43-.533a.985.985 0 01.594-.2zm-2.962.059h.036c.142 0 .27.048.399.135.146.129.264.288.344.465.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024-.152.055-.274.135-.393.2.012-.09.013-.18.003-.267v-.015c-.012-.133-.04-.2-.082-.333a.613.613 0 00-.166-.267.248.248 0 00-.183-.064h-.021c-.071.006-.13.04-.186.132a.552.552 0 00-.12.27.944.944 0 00-.023.33v.015c.012.135.037.2.08.334.046.134.098.2.166.268.01.009.02.018.034.024-.07.057-.117.07-.176.136a.304.304 0 01-.131.068 2.62 2.62 0 01-.275-.402 1.772 1.772 0 01-.155-.667 1.759 1.759 0 01.08-.668 1.43 1.43 0 01.283-.535c.128-.133.26-.2.418-.2zm1.37 1.706c.332 0 .733.065 1.216.399.293.2.523.269 1.052.468h.003c.255.136.405.266.478.399v-.131a.571.571 0 01.016.47c-.123.31-.516.643-1.063.842v.002c-.268.135-.501.333-.775.465-.276.135-.588.292-1.012.267a1.139 1.139 0 01-.448-.067 3.566 3.566 0 01-.322-.198c-.195-.135-.363-.332-.612-.465v-.005h-.005c-.4-.246-.616-.512-.686-.71-.07-.268-.005-.47.193-.6.224-.135.38-.271.483-.336.104-.074.143-.102.176-.131h.002v-.003c.169-.202.436-.47.839-.601.139-.036.294-.065.466-.065zm2.8 2.142c.358 1.417 1.196 3.475 1.735 4.473.286.534.855 1.659 1.102 3.024.156-.005.33.018.513.064.646-1.671-.546-3.467-1.089-3.966-.22-.2-.232-.335-.123-.335.59.534 1.365 1.572 1.646 2.757.13.535.16 1.104.021 1.67.067.028.135.06.205.067 1.032.534 1.413.938 1.23 1.537v-.043c-.06-.003-.12 0-.18 0h-.016c.151-.467-.182-.825-1.065-1.224-.915-.4-1.646-.336-1.77.465-.008.043-.013.066-.018.135-.068.023-.139.053-.209.064-.43.268-.662.669-.793 1.187-.13.533-.17 1.156-.205 1.869v.003c-.02.334-.17.838-.319 1.35-1.5 1.072-3.58 1.538-5.348.334a2.645 2.645 0 00-.402-.533 1.45 1.45 0 00-.275-.333c.182 0 .338-.03.465-.067a.615.615 0 00.314-.334c.108-.267 0-.697-.345-1.163-.345-.467-.931-.995-1.788-1.521-.63-.4-.986-.87-1.15-1.396-.165-.534-.143-1.085-.015-1.645.245-1.07.873-2.11 1.274-2.763.107-.065.037.135-.408.974-.396.751-1.14 2.497-.122 3.854a8.123 8.123 0 01.647-2.876c.564-1.278 1.743-3.504 1.836-5.268.048.036.217.135.289.202.218.133.38.333.59.465.21.201.477.335.876.335.039.003.075.006.11.006.412 0 .73-.134.997-.268.29-.134.52-.334.74-.4h.005c.467-.135.835-.402 1.044-.7zm2.185 8.958c.037.6.343 1.245.882 1.377.588.134 1.434-.333 1.791-.765l.211-.01c.315-.007.577.01.847.268l.003.003c.208.199.305.53.391.876.085.4.154.78.409 1.066.486.527.645.906.636 1.14l.003-.007v.018l-.003-.012c-.015.262-.185.396-.498.595-.63.401-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 01-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z"/></svg>`,
      windows: `<svg class="w-4 h-4 mr-2 text-white shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/></svg>`,
      generic: `<svg class="w-4 h-4 mr-2 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>`,
    };

    function setBtn(file: string, label: string, platform: 'android' | 'linux' | 'windows' | 'generic' = 'generic') {
      if (btn) {
        btn.setAttribute('href', base + file);
        const oldSvg = btn.querySelector('svg');
        if (oldSvg) {
          const wrapper = document.createElement('div');
          wrapper.innerHTML = icons[platform] || icons.generic;
          const newSvg = wrapper.firstElementChild;
          if (newSvg) btn.replaceChild(newSvg, oldSvg);
        }
        const span = btn.querySelector('span');
        if (span) span.textContent = label;
      }
    }

    // Dynamic Obtainium link: same detected variant as the download button,
    // with apkFilterRegEx so one tap adds the RIGHT APK (Obtainium is Android-only).
    function setObtainium(filter: string | null) {
      const ob = document.getElementById('obtainium-add');
      if (!ob) return;
      if (!filter) { (ob as HTMLElement).style.display = 'none'; return; }
      const app = {
        id: 'com.theonly.truestream',
        url: 'https://github.com/OnlyXianzo/TrueStream',
        author: 'OnlyXianzo',
        name: 'TrueStream',
        additionalSettings: JSON.stringify({ apkFilterRegEx: filter }),
      };
      ob.setAttribute(
        'href',
        'https://apps.obtainium.imranr.dev/redirect?r=' + encodeURIComponent('obtainium://app/' + JSON.stringify(app)),
      );
    }

    if (mob || /android/i.test(ua)) {
      if (/armv7|armeabi/i.test(ua)) {
        setBtn('truestream-v0.0.1-armv7-node.apk', 'Download for Android (32-bit)', 'android');
        setObtainium('armv7-node');
      } else if (/x86_64|x86/i.test(ua)) {
        setBtn('truestream-v0.0.1-x86_64-deno.apk', 'Download for Android (x86_64)', 'android');
        setObtainium('x86_64-deno');
      } else {
        setBtn('truestream-v0.0.1-arm64-deno.apk', 'Download for Android (arm64)', 'android');
        setObtainium('arm64-deno');
      }
    } else if (/win/i.test(plat) || /windows/i.test(ua)) {
      setBtn('truestream-windows-x64.zip', 'Download for Windows (x64)', 'windows');
      setObtainium(null);
    } else if (/linux/i.test(plat) || /linux/i.test(ua)) {
      setBtn('truestream-0.0.1-linux-x64.tar.gz', 'Download for Linux (x64)', 'linux');
      setObtainium(null);
    } else {
      setBtn('https://github.com/OnlyXianzo/TrueStream/releases/latest', 'Download (All Platforms)', 'generic');
      btn.setAttribute('href', 'https://github.com/OnlyXianzo/TrueStream/releases/latest');
      setObtainium(null);
    }
  })();

  // Off-screen marquee pausing to conserve mobile GPU bandwidth and battery
  (function() {
    const marquee = document.querySelector('.marquee-container');
    const track = marquee?.querySelector('.marquee-track') as HTMLElement | null;
    if (!marquee || !track || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver((entries) => {
      track.style.animationPlayState = entries[0].isIntersecting ? 'running' : 'paused';
    }, { threshold: 0.05 });

    observer.observe(marquee);
  })();
</script>
