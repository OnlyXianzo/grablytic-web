---
// src/sections/Features.astro — Why TrueStream features grid with guide deep-links
import { features } from '../data/features';
---

<section id="features" class="py-20 px-4 max-w-6xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span class="text-xs uppercase tracking-widest text-blue-400 font-bold mb-2 inline-block" data-reveal>
      Philosophy & Engine
    </span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight" data-reveal>
      Why TrueStream
    </h2>
    <p class="text-sm sm:text-base text-zinc-400 mt-3" data-reveal>
      Engineered from the bionic linker up for absolute privacy, maximum fidelity, and uncompromising speed.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {features.map((feat) => (
      <div class="glass-card p-6 flex flex-col justify-between group" data-reveal>
        <div>
          <h3 class="text-lg font-bold text-white mb-2 group-hover:text-blue-300 transition-colors">
            {feat.title}
          </h3>
          <p class="text-sm text-zinc-400 leading-relaxed mb-4">
            {feat.body}
          </p>
        </div>
        <a href={feat.guideAnchor} class="inline-flex items-center text-xs font-semibold text-blue-400 hover:text-blue-300 transition-colors pt-2 border-t border-zinc-800/80">
          <span>Explore details</span>
          <svg class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    ))}
  </div>
</section>
