---
// src/sections/Nav.astro — Directional auto-hiding floating paper pill navbar
// `base` prefixes landing anchors so docs pages link back home (e.g. base="/").
import stats from '../data/stats.json';
import ThemeToggle from '../components/ThemeToggle.astro';

const { base = '' } = Astro.props;
---

<nav id="site-nav" class="fixed top-[calc(1rem+env(safe-area-inset-top,0px))] inset-x-0 z-50 flex flex-col items-center px-4 transition-transform duration-300 ease-out" aria-label="Main Navigation">
  <div class="navbar-pill max-w-4xl w-full mx-auto px-4 sm:px-5 py-2.5 sm:py-3 rounded-full flex items-center justify-between flex-nowrap min-h-[3.25rem]">
    <a href={`${base}#top`} class="flex items-center gap-2.5 text-(--color-ink) font-bold tracking-tight hover:opacity-90 transition-opacity shrink-0">
      <img src="/logo.png" alt="Grablytic" width="24" height="24" class="w-6 h-6 rounded-md shrink-0" />
      <span class="text-sm font-semibold tracking-wide">Grablytic</span>
    </a>
    
    <div class="flex items-center gap-1.5 sm:gap-5 text-xs sm:text-sm font-medium flex-nowrap shrink-0">
      <a href={`${base}#showcase`} class="text-(--color-ink-muted) hover:text-(--color-ink) transition-colors hidden md:inline-block">Tour</a>
      <a href={`${base}#features`} class="text-(--color-ink-muted) hover:text-(--color-ink) transition-colors hidden md:inline-block">Features</a>
      <a href={`${base}#downloads`} class="text-(--color-ink-muted) hover:text-(--color-ink) transition-colors hidden md:inline-block">Downloads</a>
      <a href="/nightly" class="text-(--color-ink-muted) hover:text-(--color-ink) transition-colors hidden md:inline-block">Nightly</a>
      <a href={`${base}#faq`} class="text-(--color-ink-muted) hover:text-(--color-ink) transition-colors hidden lg:inline-block">FAQ</a>
      <a href="/docs/" class="text-(--color-ink-muted) hover:text-(--color-ink) transition-colors hidden md:inline-block">Docs</a>
      <a href="https://github.com/OnlyXianzo" target="_blank" rel="noopener noreferrer" class="text-xs text-(--color-ink-muted) hover:text-(--color-terracotta) transition-colors hidden sm:inline-flex items-center gap-1">
        <span class="text-(--color-ink-faint)">by</span>
        <span>@OnlyXianzo</span>
      </a>
      <ThemeToggle />
      <a href="https://github.com/OnlyXianzo/Grablytic" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold px-2.5 sm:px-3 py-1.5 rounded-full bg-(--color-terracotta-container)/15 text-(--color-terracotta) border border-(--color-terracotta-container)/30 hover:bg-(--color-terracotta-container)/25 transition-all flex items-center gap-1.5 shrink-0" aria-label={`Star Grablytic on GitHub (${stats.stars} stars)`}>
        <svg class="w-3.5 h-3.5 text-(--color-terracotta) shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span class="text-(--color-terracotta)">★</span> <span>{stats.stars}</span> <span class="hidden sm:inline">Star</span>
      </a>
      <button id="nav-menu-btn" type="button" class="nav-burger md:hidden p-2 -mr-1 rounded-full text-(--color-ink-muted) hover:text-(--color-ink) transition-colors shrink-0" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
        <span class="burger-lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
  <div id="nav-menu" class="nav-overlay hidden md:hidden fixed inset-0 z-40 flex-col items-center justify-center gap-2 px-8" style="background: color-mix(in srgb, var(--color-paper-base) 82%, transparent); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);" role="menu" aria-label="Site menu">
    <a href={`${base}#showcase`} role="menuitem" class="nav-overlay-link block px-4 py-3 rounded-xl text-lg font-medium text-(--color-ink-muted) hover:text-(--color-ink) transition-colors">Tour</a>
    <a href={`${base}#features`} role="menuitem" class="nav-overlay-link block px-4 py-3 rounded-xl text-lg font-medium text-(--color-ink-muted) hover:text-(--color-ink) transition-colors">Features</a>
    <a href={`${base}#downloads`} role="menuitem" class="nav-overlay-link block px-4 py-3 rounded-xl text-lg font-medium text-(--color-ink-muted) hover:text-(--color-ink) transition-colors">Downloads</a>
    <a href="/nightly" role="menuitem" class="nav-overlay-link block px-4 py-3 rounded-xl text-lg font-medium text-(--color-ink-muted) hover:text-(--color-ink) transition-colors">Nightly builds</a>
    <a href={`${base}#faq`} role="menuitem" class="nav-overlay-link block px-4 py-3 rounded-xl text-lg font-medium text-(--color-ink-muted) hover:text-(--color-ink) transition-colors">FAQ</a>
    <a href="/docs/" role="menuitem" class="nav-overlay-link block px-4 py-3 rounded-xl text-lg font-semibold text-(--color-terracotta) transition-colors">Docs →</a>
    <a href="https://github.com/OnlyXianzo" target="_blank" rel="noopener noreferrer" role="menuitem" class="nav-overlay-link block px-4 py-3 rounded-xl text-lg font-medium text-(--color-ink-muted) hover:text-(--color-ink) transition-colors">by @OnlyXianzo</a>
  </div>
</nav>

<style>
  .nav-burger .burger-lines {
    position: relative;
    display: block;
    width: 20px;
    height: 14px;
  }
  .nav-burger .burger-lines span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1), top 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .nav-burger .burger-lines span:first-child { top: 2px; }
  .nav-burger .burger-lines span:last-child { top: 10px; }
  .nav-burger[aria-expanded="true"] .burger-lines span:first-child {
    top: 6px;
    transform: rotate(45deg);
  }
  .nav-burger[aria-expanded="true"] .burger-lines span:last-child {
    top: 6px;
    transform: rotate(-45deg);
  }
  .nav-overlay:not(.hidden) {
    display: flex;
  }
  .nav-overlay-link {
    opacity: 0;
    transform: translateY(12px);
    animation: navLinkIn 0.7s cubic-bezier(0.32, 0.72, 0, 1) forwards;
  }
  .nav-overlay-link:nth-child(2) { animation-delay: 0.05s; }
  .nav-overlay-link:nth-child(3) { animation-delay: 0.1s; }
  .nav-overlay-link:nth-child(4) { animation-delay: 0.15s; }
  .nav-overlay-link:nth-child(5) { animation-delay: 0.2s; }
  .nav-overlay-link:nth-child(6) { animation-delay: 0.25s; }
  .nav-overlay-link:nth-child(7) { animation-delay: 0.3s; }
  @keyframes navLinkIn {
    to { opacity: 1; transform: translateY(0); }
  }
  .nav-link-active {
    color: var(--color-terracotta) !important;
  }
</style>

<script>
  (function() {
    const nav = document.getElementById('site-nav');
    if (!nav) return;

    let lastScrollY = Math.max(0, window.scrollY);
    let ticking = false;

    const menuBtn = document.getElementById('nav-menu-btn');
    const menu = document.getElementById('nav-menu');

    const setMenu = (open: boolean) => {
      if (!menu || !menuBtn) return;
      menu.classList.toggle('hidden', !open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';
    };

    menuBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      setMenu(menu?.classList.contains('hidden') ?? true);
    });

    menu?.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setMenu(false));
    });

    document.addEventListener('click', (e) => {
      if (menu && !menu.classList.contains('hidden') && !menu.contains(e.target as Node)) {
        setMenu(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setMenu(false);
    });

    // Current section indicator — highlights the nav link for the section in view
    const sectionLinks = new Map<string, HTMLElement[]>();
    document.querySelectorAll<HTMLAnchorElement>('nav a[href*="#"]').forEach((a) => {
      const hash = a.getAttribute('href')?.split('#')[1];
      if (!hash) return;
      if (!sectionLinks.has(hash)) sectionLinks.set(hash, []);
      sectionLinks.get(hash)!.push(a);
    });
    if ('IntersectionObserver' in window && sectionLinks.size > 0) {
      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;
          sectionLinks.forEach((links, key) => {
            links.forEach((l) => l.classList.toggle('nav-link-active', key === id));
          });
        });
      }, { rootMargin: '-40% 0px -55% 0px', threshold: 0 });
      sectionLinks.forEach((_, id) => {
        const section = document.getElementById(id);
        if (section) sectionObserver.observe(section);
      });
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const currentScrollY = Math.max(0, window.scrollY);
          const delta = currentScrollY - lastScrollY;

          // Clamped top region (overscroll protection on iOS / Android)
          if (currentScrollY <= 48) {
            nav.style.transform = 'translateY(0)';
            lastScrollY = currentScrollY;
          } else if (Math.abs(delta) > 10) {
            // Apply 10px hysteresis threshold to filter out microscopic scroll flutter
            if (delta > 0 && currentScrollY > 100) {
              nav.style.transform = 'translateY(-120%)';
            } else if (delta < 0) {
              nav.style.transform = 'translateY(0)';
            }
            lastScrollY = currentScrollY;
          }

          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  })();
</script>
