---
// src/sections/Nav.astro — Directional auto-hiding floating paper pill navbar
import stats from '../data/stats.json';
---

<nav id="site-nav" class="fixed top-[calc(1rem+env(safe-area-inset-top,0px))] inset-x-0 z-50 flex justify-center px-4 transition-transform duration-300 ease-out" aria-label="Main Navigation">
  <div class="navbar-pill max-w-4xl w-full mx-auto px-4 sm:px-5 py-2.5 sm:py-3 rounded-full flex items-center justify-between flex-nowrap min-h-[3.25rem]">
    <a href="#top" class="flex items-center gap-2.5 text-[#E5E2E1] font-bold tracking-tight hover:opacity-90 transition-opacity shrink-0">
      <img src="/logo.png" alt="Grablytic" width="24" height="24" class="w-6 h-6 rounded-md shrink-0" />
      <span class="text-sm font-semibold tracking-wide">Grablytic</span>
    </a>
    
    <div class="flex items-center gap-2.5 sm:gap-5 text-xs sm:text-sm font-medium flex-nowrap shrink-0">
      <a href="#showcase" class="text-[#D9C1BC] hover:text-[#E5E2E1] transition-colors hidden md:inline-block">Tour</a>
      <a href="#features" class="text-[#D9C1BC] hover:text-[#E5E2E1] transition-colors hidden md:inline-block">Features</a>
      <a href="#downloads" class="text-[#D9C1BC] hover:text-[#E5E2E1] transition-colors">Downloads</a>
      <a href="/nightly" class="text-[#D9C1BC] hover:text-[#E5E2E1] transition-colors hidden md:inline-block">Nightly</a>
      <a href="#faq" class="text-[#D9C1BC] hover:text-[#E5E2E1] transition-colors hidden lg:inline-block">FAQ</a>
      <a href="https://github.com/OnlyXianzo" target="_blank" rel="noopener noreferrer" class="text-xs text-[#D9C1BC] hover:text-[#FFB4A3] transition-colors hidden sm:inline-flex items-center gap-1">
        <span class="text-[#A28C87]">by</span>
        <span>@OnlyXianzo</span>
      </a>
      <a href="https://github.com/OnlyXianzo/Grablytic" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold px-2.5 sm:px-3 py-1.5 rounded-full bg-[#9B503E]/15 text-[#FFB4A3] border border-[#9B503E]/30 hover:bg-[#9B503E]/25 transition-all flex items-center gap-1.5 shrink-0" aria-label={`Star Grablytic on GitHub (${stats.stars} stars)`}>
        <svg class="w-3.5 h-3.5 text-[#FFB4A3] shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span class="text-[#FFB4A3]">★</span> <span>{stats.stars}</span> <span>Star</span>
      </a>
    </div>
  </div>
</nav>

<script>
  (function() {
    const nav = document.getElementById('site-nav');
    if (!nav) return;

    let lastScrollY = Math.max(0, window.scrollY);
    let ticking = false;

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const currentScrollY = Math.max(0, window.scrollY);
          const delta = currentScrollY - lastScrollY;

          // Clamped top region (overscroll protection on iOS / Android)
          if (currentScrollY <= 48) {
            nav.style.transform = 'translateY(0)';
            lastScrollY = currentScrollY;
          } else if (Math.abs(delta) > 10) {
            // Apply 10px hysteresis threshold to filter out microscopic scroll flutter
            if (delta > 0 && currentScrollY > 100) {
              nav.style.transform = 'translateY(-120%)';
            } else if (delta < 0) {
              nav.style.transform = 'translateY(0)';
            }
            lastScrollY = currentScrollY;
          }

          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  })();
</script>
