---
// src/sections/Footer.astro — Legal links, contact, DMCA, and licensing (DESIGN.md Earth Tones)
import { REPO } from '../data/downloads';
---

<footer class="py-12 px-4 max-w-5xl mx-auto border-t border-(--color-tile-highest) text-center text-xs text-(--color-ink-muted) space-y-4">
  <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-(--color-ink-muted) font-medium">
    <a href={`${REPO}/blob/main/DMCA.md`} class="hover:text-(--color-ink) transition-colors">DMCA Notice</a>
    <span class="text-(--color-line)" aria-hidden="true">•</span>
    <a href={`${REPO}/blob/main/LICENSE`} class="hover:text-(--color-ink) transition-colors">GPL-3.0 License</a>
    <span class="text-(--color-line)" aria-hidden="true">•</span>
    <a href={`${REPO}/blob/main/SECURITY.md`} class="hover:text-(--color-ink) transition-colors">Security Policy</a>
    <span class="text-(--color-line)" aria-hidden="true">•</span>
    <a href="mailto:xianzo.help@gmail.com" class="hover:text-(--color-ink) transition-colors">xianzo.help@gmail.com</a>
  </div>

  <nav aria-label="Documentation" class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-(--color-ink-muted) font-medium">
    <a href="/docs/" class="hover:text-(--color-ink) transition-colors">Docs</a>
    <a href="/docs/install/" class="hover:text-(--color-ink) transition-colors">Install</a>
    <a href="/docs/usage/" class="hover:text-(--color-ink) transition-colors">Usage manual</a>
    <a href="/docs/faq/" class="hover:text-(--color-ink) transition-colors">FAQ</a>
    <a href="/docs/troubleshooting/" class="hover:text-(--color-ink) transition-colors">Troubleshooting</a>
  </nav>

  <p class="max-w-2xl mx-auto leading-relaxed text-(--color-ink-faint) text-[11px]">
    Grablytic is an open-source, client-side media extraction tool powered by yt-dlp. Grablytic hosts no media, streams, or copyrighted files. All media is fetched directly from public platform streams on your local device.
  </p>

  <!-- Security scans: re-add verified per-version hashes + scan links here after manual verification. -->

</footer>

<dialog id="donate-dialog" aria-labelledby="donate-dialog-title" tabindex="-1" class="backdrop:bg-black/85 backdrop:backdrop-blur-sm bg-(--color-tile-low) text-(--color-ink) border border-(--color-line)/50 rounded-2xl p-6 max-w-md w-full shadow-2xl mx-auto my-auto">
  <div class="flex justify-between items-center mb-4">
    <h3 id="donate-dialog-title" class="text-base font-bold text-(--color-ink) flex items-center gap-2">
      <span class="text-(--color-terracotta)">♥</span> Support Grablytic
    </h3>
    <button onclick="(window.__closeDonateDialog ?? (() => document.getElementById('donate-dialog')?.close()))()" class="text-(--color-ink-faint) hover:text-(--color-ink) p-1 cursor-pointer" aria-label="Close dialog">
      ✕
    </button>
  </div>

  <p class="text-xs text-(--color-ink-muted) leading-relaxed">
    Grablytic is free forever. If it saves you time, consider tipping — every contribution keeps the updates coming. Thank you.
  </p>

  <div class="space-y-3 text-xs">
    <div class="flex justify-between items-center p-2.5 rounded-lg bg-(--color-tile-lowest) border border-(--color-tile-highest)">
      <span class="font-medium text-(--color-ink-muted)">GitHub Sponsors</span>
      <a href="https://github.com/sponsors/OnlyXianzo" target="_blank" rel="noopener noreferrer" class="text-(--color-terracotta) hover:underline">
        sponsor @OnlyXianzo →
      </a>
    </div>

    <div>
      <span class="text-(--color-ink-faint) block mb-1 font-semibold">Ethereum (ETH / ERC-20):</span>
      <code class="block p-2 rounded bg-(--color-tile-lowest) border border-(--color-tile-highest) font-mono text-[10px] text-(--color-ink-muted) break-all select-all">
        0x3fc5A8Bd48575F761504506aF3ba082e38C8CD3A
      </code>
    </div>
  </div>

  <button onclick="(window.__closeDonateDialog ?? (() => document.getElementById('donate-dialog')?.close()))()" class="mt-6 w-full py-2.5 rounded-xl bg-(--color-tile-high) hover:bg-(--color-tile-highest) text-(--color-ink) font-medium text-xs transition cursor-pointer border border-(--color-line)/30">
    Close
  </button>
</dialog>

<script>
  import { initDonateDialogClose } from '../lib/gsap';
  initDonateDialogClose();
</script>
