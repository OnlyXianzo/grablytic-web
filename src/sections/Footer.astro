---
// src/sections/Footer.astro — Legal links, contact, DMCA, and licensing (DESIGN.md Earth Tones)
import { REPO } from '../data/downloads';
---

<footer class="py-12 px-4 max-w-5xl mx-auto border-t border-[#353534] text-center text-xs text-[#D9C1BC] space-y-4">
  <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-[#D9C1BC] font-medium">
    <a href={`${REPO}/blob/main/DMCA.md`} class="hover:text-[#E5E2E1] transition-colors">DMCA Notice</a>
    <span class="text-[#54433F]" aria-hidden="true">•</span>
    <a href={`${REPO}/blob/main/LICENSE`} class="hover:text-[#E5E2E1] transition-colors">GPL-3.0 License</a>
    <span class="text-[#54433F]" aria-hidden="true">•</span>
    <a href={`${REPO}/blob/main/SECURITY.md`} class="hover:text-[#E5E2E1] transition-colors">Security Policy</a>
    <span class="text-[#54433F]" aria-hidden="true">•</span>
    <a href="mailto:xianzo.help@gmail.com" class="hover:text-[#E5E2E1] transition-colors">xianzo.help@gmail.com</a>
  </div>

  <p class="max-w-2xl mx-auto leading-relaxed text-[#A28C87] text-[11px]">
    Grablytic is an open-source, client-side media extraction tool powered by yt-dlp. Grablytic hosts no media, streams, or copyrighted files. All media is fetched directly from public platform streams on your local device.
  </p>

  <p class="text-[#A28C87] text-[10px]">
    VirusTotal: <a class="text-zinc-300 hover:text-white underline underline-offset-2" href="https://www.virustotal.com/gui/file/11d1d7bfe4ccbb4b9ba07afa2f4177e4ae644b4f1ed42d4f02efc8c256e0e5ca">all 15 v0.0.1 packages — 0 detections</a> · <a class="text-zinc-300 hover:text-white underline underline-offset-2" href="https://github.com/OnlyXianzo/Grablytic/blob/main/docs/security-scans.md">full scan record</a>.
  </p>
</footer>

<dialog id="donate-dialog" class="backdrop:bg-black/85 backdrop:backdrop-blur-sm bg-[#1C1B1B] text-[#E5E2E1] border border-[#54433F]/50 rounded-2xl p-6 max-w-md w-full shadow-2xl mx-auto my-auto">
  <div class="flex justify-between items-center mb-4">
    <h3 class="text-base font-bold text-[#E5E2E1] flex items-center gap-2">
      <span class="text-[#FFB4A3]">♥</span> Support Grablytic
    </h3>
    <button onclick="document.getElementById('donate-dialog')?.close()" class="text-[#A28C87] hover:text-[#E5E2E1] p-1 cursor-pointer" aria-label="Close dialog">
      ✕
    </button>
  </div>

  <p class="text-xs text-[#D9C1BC] leading-relaxed">
    Grablytic is free forever. If it saves you time, consider tipping — every contribution keeps the updates coming. Thank you.
  </p>

  <div class="space-y-3 text-xs">
    <div class="flex justify-between items-center p-2.5 rounded-lg bg-[#0E0E0E] border border-[#353534]">
      <span class="font-medium text-[#D9C1BC]">GitHub Sponsors</span>
      <a href="https://github.com/sponsors/OnlyXianzo" target="_blank" rel="noopener noreferrer" class="text-[#FFB4A3] hover:underline">
        sponsor @OnlyXianzo →
      </a>
    </div>

    <div>
      <span class="text-[#A28C87] block mb-1 font-semibold">Ethereum (ETH / ERC-20):</span>
      <code class="block p-2 rounded bg-[#0E0E0E] border border-[#353534] font-mono text-[10px] text-[#D9C1BC] break-all select-all">
        0x3fc5A8Bd48575F761504506aF3ba082e38C8CD3A
      </code>
    </div>
  </div>

  <button onclick="document.getElementById('donate-dialog')?.close()" class="mt-6 w-full py-2.5 rounded-xl bg-[#2A2A2A] hover:bg-[#353534] text-[#E5E2E1] font-medium text-xs transition cursor-pointer border border-[#54433F]/30">
    Close
  </button>
</dialog>
