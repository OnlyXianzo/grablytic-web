---
// src/sections/Showcase.astro — Fluid Center-Magnifying 3D Screenshot Showcase (Anti-AI Earth Aesthetic)
---

<section id="showcase" class="text-center py-20 px-4 overflow-hidden relative scroll-mt-24">
  <div class="showcase-header mb-10 max-w-2xl mx-auto">
    <span class="eyebrow mb-2 inline-block" data-reveal>
      App Tour · Live Interface
    </span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-[#E5E2E1] tracking-tight" data-reveal>
      See it in action
    </h2>
    <p class="text-sm sm:text-base text-[#D9C1BC] mt-3" data-reveal>
      Authentic screenshots captured directly from the v0.0.1 Flutter engine — explore Home, Search, Format Picker, Queue, and Settings.
    </p>
  </div>

  <div class="shots-container relative w-full overflow-hidden">
    <!-- Fluid drag & scroll track -->
    <div id="showcase-track" class="shots flex gap-4 sm:gap-6 overflow-x-auto py-12 px-4 justify-start items-center flex-nowrap" role="region" aria-label="Grablytic screen tour carousel" tabindex="0">
      <!-- Frame 0: Home -->
      <div class="frame" data-index="0" tabindex="0" role="group" aria-label="Home screen">
        <div class="frame-inner">
          <div class="frame-tag">HOME</div>
          <img src="/shots/optimized/home-screen.webp" alt="Grablytic Home — empty state" width="400" height="888" class="screen-img" loading="lazy" decoding="async" />
        </div>
      </div>

      <!-- Frame 1: Search -->
      <div class="frame" data-index="1" tabindex="0" role="group" aria-label="Cookies and logins">
        <div class="frame-inner">
          <div class="frame-tag">LOGIN & COOKIES</div>
          <img src="/shots/optimized/cookies-screen.webp" alt="Grablytic Cookies and site logins" width="400" height="888" class="screen-img" loading="lazy" decoding="async" />
        </div>
      </div>

      <!-- Frame 2: Format Picker Hero -->
      <div class="frame is-active" data-index="2" tabindex="0" role="group" aria-label="16K HDR Format Picker">
        <div class="frame-inner">
          <div class="frame-tag frame-tag-hero">16K HDR PICKER</div>
          <img src="/shots/optimized/format-picker-16k.webp" alt="Grablytic Format Picker — 16K HDR streams" width="400" height="888" class="screen-img" loading="lazy" decoding="async" />
        </div>
      </div>

      <!-- Frame 3: Queue -->
      <div class="frame" data-index="3" tabindex="0" role="group" aria-label="Live downloads queue">
        <div class="frame-inner">
          <div class="frame-tag">LIVE QUEUE</div>
          <img src="/shots/optimized/library-downloads.webp" alt="Grablytic Library — live downloads" width="400" height="888" class="screen-img" loading="lazy" decoding="async" />
        </div>
      </div>

      <!-- Frame 4: Settings -->
      <div class="frame" data-index="4" tabindex="0" role="group" aria-label="Application settings">
        <div class="frame-inner">
          <div class="frame-tag">SETTINGS</div>
          <img src="/shots/optimized/settings-general.webp" alt="Grablytic Settings" width="400" height="888" class="screen-img" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Pagination Dots -->
  <div class="showcase-dots flex justify-center items-center gap-2 mt-4" aria-label="Showcase carousel navigation">
    <button class="dot-btn h-2 rounded-full transition-all duration-300 w-2 bg-[#54433F]/60 hover:bg-[#A28C87]" data-index="0" aria-label="Slide 1: Home"></button>
    <button class="dot-btn h-2 rounded-full transition-all duration-300 w-2 bg-[#54433F]/60 hover:bg-[#A28C87]" data-index="1" aria-label="Slide 2: Cookies"></button>
    <button class="dot-btn h-2 rounded-full transition-all duration-300 w-6 bg-[#FFB4A3]" data-index="2" aria-label="Slide 3: Format Picker" aria-current="true"></button>
    <button class="dot-btn h-2 rounded-full transition-all duration-300 w-2 bg-[#54433F]/60 hover:bg-[#A28C87]" data-index="3" aria-label="Slide 4: Downloads"></button>
    <button class="dot-btn h-2 rounded-full transition-all duration-300 w-2 bg-[#54433F]/60 hover:bg-[#A28C87]" data-index="4" aria-label="Slide 5: Settings"></button>
  </div>

  <p class="text-xs text-[#A28C87] mt-3 tracking-wide flex items-center justify-center gap-1.5" aria-hidden="true">
    <span class="hidden sm:inline">← drag or scroll horizontally to explore →</span>
    <span class="sm:hidden">← swipe horizontally to explore →</span>
  </p>
</section>

<style>
  .shots-container {
    perspective: 1200px;
    perspective-origin: center center;
    position: relative;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .shots {
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    touch-action: pan-y pinch-zoom;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    scroll-behavior: smooth;
    padding-inline: calc(50% - 86px);
    scroll-padding-inline: calc(50% - 86px);
  }
  .shots::-webkit-scrollbar {
    display: none;
  }
  .shots.is-grabbing {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  .frame {
    position: relative;
    width: 172px;
    flex: 0 0 auto;
    aspect-ratio: 9/19;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    outline: none;
    cursor: pointer;
  }

  .frame-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 28px;
    border: 1px solid rgba(84, 67, 63, 0.45);
    background: var(--color-tile-low, #181514);
    padding: 5px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.65);
    transform-origin: center center;
    will-change: transform, opacity;
    transition: box-shadow 300ms ease, border-color 300ms ease;
  }

  /* SSR fallback for active card */
  .frame.is-active .frame-inner {
    border-color: rgba(255, 180, 163, 0.65);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.85), 0 0 28px rgba(155, 80, 62, 0.3);
  }

  /* Tactile Frame Caption Tag */
  .frame-tag {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 15;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(14, 14, 14, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #D9C1BC;
    pointer-events: none;
    white-space: nowrap;
    transition: background 300ms ease, border-color 300ms ease, color 300ms ease;
  }

  .frame.is-active .frame-tag,
  .frame-tag-hero {
    background: rgba(155, 80, 62, 0.75);
    border-color: rgba(255, 180, 163, 0.5);
    color: #FFFFFF;
  }

  /* Tactile Hardware Rim Light */
  .frame-inner::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 29px;
    opacity: 0;
    box-shadow: inset 0 0 0 1px rgba(255, 180, 163, 0.35), 0 8px 24px rgba(125, 57, 41, 0.15);
    transition: opacity 400ms ease-out;
    pointer-events: none;
    z-index: 10;
  }

  .frame.is-active .frame-inner::before {
    opacity: 1;
    box-shadow: inset 0 0 0 1.5px rgba(255, 180, 163, 0.6), 0 14px 36px rgba(125, 57, 41, 0.3);
  }

  .screen-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 23px;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .frame {
      width: 190px;
    }
    .shots {
      padding-inline: calc(50% - 95px);
      scroll-padding-inline: calc(50% - 95px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame-inner {
      will-change: auto !important;
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  (function() {
    const showcase = document.getElementById('showcase');
    if (!showcase) return;

    const track = document.getElementById('showcase-track') as HTMLElement | null;
    if (!track) return;

    const frames = Array.from(track.querySelectorAll<HTMLElement>('.frame'));
    const frameInners = frames.map(f => f.querySelector<HTMLElement>('.frame-inner')).filter(Boolean) as HTMLElement[];
    const dots = Array.from(showcase.querySelectorAll<HTMLButtonElement>('.dot-btn'));

    if (frames.length === 0 || frameInners.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Immutable geometry cache — updated strictly via ResizeObserver
    let containerWidth = 0;
    let frameWidth = 0;
    let pitch = 0;
    let frameCenters: number[] = [];
    let isTicking = false;

    function measureGeometry() {
      if (!track) return;
      containerWidth = track.clientWidth;
      frameWidth = frames[0].offsetWidth;
      pitch = frames.length > 1 ? (frames[1].offsetLeft - frames[0].offsetLeft) : frameWidth;
      frameCenters = frames.map(f => f.offsetLeft + frameWidth / 2);
    }

    // Mathematical Coverflow Transform (Zero Layout Queries in Loop)
    function updateCoverflow() {
      isTicking = false;
      if (!track || containerWidth === 0 || pitch === 0) return;

      const scrollCenter = track.scrollLeft + (containerWidth / 2);
      let nearestIdx = 0;
      let minDistance = Infinity;

      for (let i = 0; i < frames.length; i++) {
        const frame = frames[i];
        const inner = frameInners[i];
        const center = frameCenters[i] || (frame.offsetLeft + frameWidth / 2);
        const dist = (center - scrollCenter) / pitch;
        const absDist = Math.abs(dist);

        if (absDist < minDistance) {
          minDistance = absDist;
          nearestIdx = i;
        }

        if (reducedMotion) {
          inner.style.transform = 'none';
          inner.style.opacity = '1';
          continue;
        }

        // Cosine bell-curve: 1.0 at center, smoothly tapering to 0.0 at |dist| >= 1.0
        const clampedDist = Math.min(1.0, absDist);
        const weight = (1 + Math.cos(Math.PI * clampedDist)) / 2;

        // Dynamic properties:
        // Scale: 0.88 -> 1.08 (active center magnification)
        const scale = 0.88 + weight * 0.20;
        // Inward 3D tilt: left cards tilt right, right cards tilt left
        const rotateY = -Math.max(-1, Math.min(1, dist)) * 14;
        // Z-depth: active card floats forward in 3D
        const translateZ = (weight - 1) * 60;
        // Opacity: 0.75 -> 1.0
        const opacity = 0.75 + weight * 0.25;
        // Elevation: center card always floats on top of siblings
        const zIndex = Math.round(weight * 50) + 1;

        inner.style.transform = `perspective(1000px) translateZ(${translateZ.toFixed(1)}px) scale(${scale.toFixed(4)}) rotateY(${rotateY.toFixed(2)}deg)`;
        inner.style.opacity = opacity.toFixed(3);
        frame.style.zIndex = zIndex.toString();

        if (weight > 0.55) {
          frame.classList.add('is-active');
        } else {
          frame.classList.remove('is-active');
        }
      }

      // Update Pagination Dots
      dots.forEach((dot, idx) => {
        if (idx === nearestIdx) {
          dot.classList.remove('w-2', 'bg-[#54433F]/60');
          dot.classList.add('w-6', 'bg-[#FFB4A3]');
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.classList.remove('w-6', 'bg-[#FFB4A3]');
          dot.classList.add('w-2', 'bg-[#54433F]/60');
          dot.removeAttribute('aria-current');
        }
      });
    }

    function requestUpdate() {
      if (!isTicking) {
        requestAnimationFrame(updateCoverflow);
        isTicking = true;
      }
    }

    // Scroll listener for real-time mobile swipe & trackpad scroll
    track.addEventListener('scroll', requestUpdate, { passive: true });

    // Center specific slide
    function scrollToSlide(idx: number, smooth: boolean = true) {
      if (!track || idx < 0 || idx >= frames.length) return;
      const targetCenter = frameCenters[idx] || (frames[idx].offsetLeft + frameWidth / 2);
      const targetScroll = targetCenter - (containerWidth / 2);
      track.scrollTo({
        left: targetScroll,
        behavior: smooth ? 'smooth' : 'auto'
      });
    }

    // Unified Pointer Drag & Swipe (Touch + Mouse with 45° axis lock & momentum)
    let isPointerDown = false;
    let isDragging = false;
    let isScrolling = false;
    let startX = 0;
    let startY = 0;
    let startScrollLeft = 0;
    let hasMoved = false;
    let activePointerId: number | null = null;
    let lastX = 0;
    let lastTime = 0;
    let velocity = 0;

    track.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      isPointerDown = true;
      isDragging = false;
      isScrolling = false;
      hasMoved = false;
      startX = e.clientX;
      startY = e.clientY;
      lastX = e.clientX;
      lastTime = performance.now();
      velocity = 0;
      startScrollLeft = track.scrollLeft;
      activePointerId = e.pointerId;
    });

    track.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isPointerDown || e.pointerId !== activePointerId || isScrolling) return;
      const deltaX = e.clientX - startX;
      const deltaY = e.clientY - startY;

      // Axis disambiguation: lock horizontal drag if horizontal swipe dominates
      if (!isDragging) {
        const absX = Math.abs(deltaX);
        const absY = Math.abs(deltaY);
        if (absX > 6 || absY > 6) {
          const angle = Math.atan2(absY, absX) * (180 / Math.PI);
          if (angle > 45) {
            // Dominant vertical motion: yield to native page scroll
            isScrolling = true;
            return;
          }
          // Dominant horizontal motion: lock into carousel swipe
          isDragging = true;
          hasMoved = true;
          track.classList.add('is-grabbing');
          try {
            track.setPointerCapture(e.pointerId);
          } catch (_) {}
        }
      }

      if (isDragging) {
        const now = performance.now();
        const dt = now - lastTime;
        if (dt > 0) {
          velocity = (e.clientX - lastX) / dt;
          lastX = e.clientX;
          lastTime = now;
        }
        track.scrollLeft = startScrollLeft - deltaX;
        requestUpdate();
      }
    });

    function endPointer(e: PointerEvent) {
      if (!track || e.pointerId !== activePointerId) return;
      isPointerDown = false;
      track.classList.remove('is-grabbing');
      if (track.hasPointerCapture(e.pointerId)) {
        try {
          track.releasePointerCapture(e.pointerId);
        } catch (_) {}
      }
      activePointerId = null;

      if (isDragging) {
        isDragging = false;
        // Inertial flick target calculation
        const flickDistance = velocity * 100;
        const targetScroll = track.scrollLeft - flickDistance + (containerWidth / 2);
        let closestIdx = 0;
        let minDiff = Infinity;
        for (let i = 0; i < frameCenters.length; i++) {
          const diff = Math.abs(frameCenters[i] - targetScroll);
          if (diff < minDiff) {
            minDiff = diff;
            closestIdx = i;
          }
        }
        scrollToSlide(closestIdx, true);
      }
    }

    track.addEventListener('pointerup', endPointer);
    track.addEventListener('pointercancel', endPointer);

    // Frame click to focus
    frames.forEach((frame, idx) => {
      frame.addEventListener('click', (e) => {
        if (hasMoved) {
          e.preventDefault();
          return;
        }
        scrollToSlide(idx, true);
      });

      frame.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          scrollToSlide(idx, true);
        }
      });
    });

    // Dot navigation
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        scrollToSlide(idx, true);
      });
    });

    // ResizeObserver to recalibrate cached coordinates
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => {
        measureGeometry();
        updateCoverflow();
      });
      ro.observe(track);
    }

    // Initial setup: measure and center Format Picker (index 2)
    function init() {
      measureGeometry();
      scrollToSlide(2, false);
      updateCoverflow();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
