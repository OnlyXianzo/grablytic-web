---
// src/sections/Showcase.astro — Converge-and-glow screenshot showcase strip
---

<section id="showcase" class="text-center py-16 px-4 overflow-hidden relative">
  <div class="showcase-header mb-8 max-w-2xl mx-auto">
    <span class="text-xs uppercase tracking-widest text-blue-400 font-bold mb-2 inline-block" data-reveal>
      App Tour
    </span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight" data-reveal>
      See it in action
    </h2>
    <p class="text-sm sm:text-base text-zinc-400 mt-3" data-reveal>
      Real UI mockups of the v0.0.1 app — swipe through Home, Search, Format Picker, Queue, and Settings.
    </p>
  </div>

  <div class="shots-container relative w-full overflow-hidden">
    <div class="shots flex gap-5 overflow-x-auto scroll-smooth py-8 px-4 sm:px-8 justify-start sm:justify-center items-center flex-nowrap scrollbar-thin">
      <!-- Frame 0: Home -->
      <div class="frame" data-side="left" style="--i:0">
        <img src="/shots/home.png" alt="TrueStream Home Screen" width="720" height="1520" class="screen-img" loading="lazy" />
      </div>

      <!-- Frame 1: Search -->
      <div class="frame" data-side="near-left" style="--i:1">
        <img src="/shots/search.png" alt="TrueStream Search Screen" width="720" height="1520" class="screen-img" loading="lazy" />
      </div>

      <!-- Frame 2: Format Picker Hero -->
      <div class="frame" data-side="center" style="--i:2">
        <img src="/shots/format-picker.png" alt="TrueStream Stream Format Picker" width="720" height="1520" class="screen-img" loading="lazy" />
      </div>

      <!-- Frame 3: Queue -->
      <div class="frame" data-side="near-right" style="--i:3">
        <img src="/shots/queue.png" alt="TrueStream Downloads Queue" width="720" height="1520" class="screen-img" loading="lazy" />
      </div>

      <!-- Frame 4: Settings -->
      <div class="frame" data-side="right" style="--i:4">
        <img src="/shots/settings.png" alt="TrueStream Engine Settings" width="720" height="1520" class="screen-img" loading="lazy" />
      </div>
    </div>
  </div>

  <p class="text-xs text-zinc-400 mt-4 tracking-wide flex items-center justify-center gap-1.5 sm:hidden" aria-hidden="true">
    <span>←</span> swipe horizontally to explore <span>→</span>
  </p>
</section>

<style>
  .shots {
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  .shots::-webkit-scrollbar {
    height: 6px;
  }
  .shots::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 6px;
  }

  .frame {
    position: relative;
    width: 172px;
    flex: 0 0 auto;
    aspect-ratio: 9/19;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #010409;
    padding: 5px;
    display: flex;
    flex-direction: column;
    will-change: transform, opacity;
    opacity: 0;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55);
    scroll-snap-align: center;
    transition: transform 560ms cubic-bezier(.16, 1, .3, 1), opacity 560ms cubic-bezier(.16, 1, .3, 1);
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  .frame[data-side="left"] { transform: translateX(-120px); }
  .frame[data-side="near-left"] { transform: translateX(-60px); }
  .frame[data-side="center"] { transform: scale(.92); }
  .frame[data-side="near-right"] { transform: translateX(60px); }
  .frame[data-side="right"] { transform: translateX(120px); }

  #showcase.inview .frame {
    transform: none;
    opacity: 1;
  }

  /* Glowing device border (compositor-only opacity transition on pseudo-element) */
  .frame::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 29px;
    opacity: 0;
    box-shadow: 0 0 28px 2px rgba(88, 166, 255, .55), 0 0 64px 8px rgba(137, 87, 229, .28), inset 0 0 0 1px rgba(88, 166, 255, .65);
    transition: opacity 700ms ease-out 150ms;
    pointer-events: none;
    z-index: 10;
  }

  .frame[data-side="center"]::before {
    box-shadow: 0 0 36px 4px rgba(88, 166, 255, .7), 0 0 80px 12px rgba(57, 211, 83, .25), inset 0 0 0 1.5px rgba(88, 166, 255, .85);
  }

  #showcase.inview .frame::before {
    opacity: 1;
  }

  .screen-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 23px;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  @media (max-width: 900px) {
    .frame { width: 148px; }
  }

  @media (max-width: 640px) {
    .frame { width: 190px; }
    .frame[data-side] { transform: translateY(40px); }
    #showcase.inview .frame { transform: none; opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame, .frame::before {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  // Single IntersectionObserver activating converge & glow animations
  (function() {
    const showcase = document.getElementById('showcase');
    if (!showcase) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      showcase.classList.add('inview');
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        showcase.classList.add('inview');
        observer.disconnect();
      }
    }, { threshold: 0.2 });

    observer.observe(showcase);
  })();
</script>
