---
// src/sections/Faq.astro — Straight answers FAQ accordion (DESIGN.md Earth Tones)
import { faqs } from '../data/faqs';
---

<section id="faq" class="py-20 px-4 max-w-4xl mx-auto section-contain">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span class="eyebrow mb-2 inline-block" data-reveal>
      Clarity & Trust
    </span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-[#E5E2E1] tracking-tight" data-reveal>
      Straight Answers
    </h2>
    <p class="text-sm sm:text-base text-[#D9C1BC] mt-3" data-reveal>
      Direct answers regarding privacy, licensing, binary integrity, and hardware optimization.
    </p>
  </div>

  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="faq-item group" data-reveal>
        <summary class="text-[#E5E2E1] text-base sm:text-lg font-semibold">
          <span>{faq.q}</span>
        </summary>
        <p class="mt-3 text-xs sm:text-sm text-[#D9C1BC] leading-relaxed pt-3 border-t border-[#353534]">
          {faq.a}
        </p>
      </details>
    ))}
  </div>
</section>
