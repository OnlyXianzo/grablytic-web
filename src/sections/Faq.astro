---
// src/sections/Faq.astro — Straight answers FAQ accordion (DESIGN.md Earth Tones)
import { faqs } from '../data/faqs';
---

<section id="faq" class="py-20 px-4 scroll-mt-24 max-w-4xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-8">
    <span class="eyebrow mb-2 inline-block" data-reveal>
      Clarity and trust
    </span>
    <h2 class="text-3xl sm:text-4xl font-bold text-(--color-ink) tracking-tight" data-reveal>
      Straight answers
    </h2>
    <p class="text-sm sm:text-base text-(--color-ink-muted) mt-3" data-reveal>
      Direct answers on privacy, licensing, binary integrity, and hardware tuning.
    </p>
  </div>

  <div class="max-w-xl mx-auto mb-6" data-reveal>
    <label for="faq-search" class="sr-only">Search answers</label>
    <input
      id="faq-search"
      type="search"
      placeholder="Search answers (privacy, APK, quality…)"
      autocomplete="off"
      class="w-full px-4 py-3 rounded-xl bg-(--color-tile-low) border border-(--color-line)/40 text-sm text-(--color-ink) placeholder:text-(--color-ink-faint) focus:border-(--color-terracotta)/50 focus:outline-none"
    />
  </div>

  <div class="space-y-3" id="faq-list">
    {faqs.map((faq) => (
      <details class="faq-item group" data-reveal data-faq-item>
        <summary class="text-(--color-ink) text-base sm:text-lg font-semibold">
          <span>{faq.q}</span>
        </summary>
        <p class="mt-3 text-xs sm:text-sm text-(--color-ink-muted) leading-relaxed pt-3 border-t border-(--color-tile-highest)">
          {faq.a}
        </p>
      </details>
    ))}
  </div>

  <div id="faq-empty" class="hidden text-center py-10 px-6 rounded-2xl bg-(--color-tile-low) border border-(--color-line)/40" role="status">
    <p class="text-sm font-semibold text-(--color-ink)">No answers match that search.</p>
    <p class="text-xs text-(--color-ink-muted) mt-1">Try “privacy”, “APK”, or “quality” — or <a href="/docs/faq/" class="text-(--color-terracotta) hover:underline">browse the full FAQ</a>.</p>
  </div>
</section>

<script>
  (function () {
    const input = document.getElementById('faq-search') as HTMLInputElement | null;
    const list = document.getElementById('faq-list');
    const empty = document.getElementById('faq-empty');
    if (!input || !list) return;
    const items = Array.from(list.querySelectorAll('[data-faq-item]')) as HTMLElement[];
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      items.forEach((item) => {
        const hit = !q || (item.textContent || '').toLowerCase().includes(q);
        item.style.display = hit ? '' : 'none';
        if (hit) visible++;
      });
      empty?.classList.toggle('hidden', visible > 0);
    });
  })();
</script>
