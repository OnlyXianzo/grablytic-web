---
// src/sections/Faq.astro — Straight answers FAQ accordion
import { faqs } from '../data/faqs';
---

<section id="faq" class="py-20 px-4 max-w-4xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span class="text-xs uppercase tracking-widest text-blue-400 font-bold mb-2 inline-block" data-reveal>
      Clarity & Trust
    </span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight" data-reveal>
      Straight Answers
    </h2>
    <p class="text-sm sm:text-base text-zinc-400 mt-3" data-reveal>
      Clear, straightforward answers about licensing, privacy, data handling, and platform updates.
    </p>
  </div>

  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="faq-item group" data-reveal>
        <summary class="text-white text-base sm:text-lg font-semibold">
          <span>{faq.q}</span>
        </summary>
        <p class="mt-3 text-sm text-zinc-400 leading-relaxed pt-2 border-t border-zinc-800/80">
          {faq.a}
        </p>
      </details>
    ))}
  </div>
</section>
